# Copy to .env (never commit real keys) or set these in your shell.

# Which model nl2pipe calls. Any litellm-supported model works.
#   Anthropic: claude-sonnet-4-5
#   OpenAI:    gpt-4o
#   Local:     ollama/llama3.1   (no key needed)
NL2PIPE_MODEL=claude-sonnet-4-5

# Provide the key for whichever provider you chose above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
